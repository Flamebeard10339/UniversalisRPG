#!/usr/bin/env bash

# A real git commit-msg hook (not a Claude-Code PreToolUse hook — see
# block-main-git-writes.sh in this same directory for that other kind).
# Activate with: git config core.hooksPath .claude/hooks
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$here" || exit 1

msg_file="$1"
git_dir=$(git rev-parse --git-dir)

merge_or_revert=""
if [ -f "$git_dir/MERGE_HEAD" ] || [ -f "$git_dir/REVERT_HEAD" ]; then
  merge_or_revert="--merge-or-revert"
fi

files=$(git diff --cached --name-only | tr '\n' ',' | sed 's/,$//')

if [ -f "node_modules/tsx/dist/cli.mjs" ]; then
  node node_modules/tsx/dist/cli.mjs scripts/tasks.ts check-commit-msg "$msg_file" $merge_or_revert --files "$files"
else
  npx tsx scripts/tasks.ts check-commit-msg "$msg_file" $merge_or_revert --files "$files"
fi

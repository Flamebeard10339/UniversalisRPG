{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-main-git-writes.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/report-running-long-jobs.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/friction-on-subagent-stop.sh",
            "timeout": 60,
            "statusMessage": "Reading back what the subagent had to work out"
          }
        ]
      }
    ]
  }
}

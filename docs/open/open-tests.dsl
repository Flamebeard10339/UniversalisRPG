// Red on purpose. Every # test below is named by an open line in this folder, whose
// closing clause is this route walking. Nothing here ships: it is loaded beside the
// corpus by `npm run handoff` and by hand, and never out of content/.
//
// A route belongs here while it has nowhere yet to stand. A proof about a refusal,
// or about the words a screen says, goes in open-tests.test.ts instead: a section
// the loader will not take stops this whole file rather than failing on its own.
# info open-tests
version: 0.0.0
dependencies:
  tulsa

# test george-answers-for-himself-while-the-quest-stands-beside-him
load: in-town
travel: kelsa-farmhouse
talk: george
choose: helpful
choose: continue
talk: george
choose: birds-and-the-bees
choose: continue

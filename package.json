{
  "name": "universalis-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open --configLoader runner",
    "dev:android": "concurrently \"vite --configLoader runner\" \"wait-on http://localhost:5173 && cap run android --livereload\"",
    "build": "tsc && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "sync": "npm run build && cap sync",
    "test": "vitest run --configLoader runner",
    "test:app": "vitest run --configLoader runner --project app",
    "test:tools": "vitest run --configLoader runner --project tools",
    "layer-check": "tsx scripts/layer-check.ts",
    "play": "tsx scripts/play-cli.ts",
    "playbot": "tsx scripts/playbot.ts",
    "authorbot": "tsx scripts/authorbot.ts",
    "probe": "tsx scripts/probe.ts",
    "oracle": "tsx scripts/oracle.ts",
    "balance": "tsx scripts/balance.ts",
    "handoff": "tsx scripts/handoff.ts",
    "notes": "tsx scripts/notes.ts",
    "review": "tsx scripts/review.ts",
    "inspect": "tsx scripts/inspect.ts",
    "mutate": "tsx scripts/mutate.ts",
    "migrate-saves": "tsx scripts/migrate-saves.ts",
    "rename-module": "tsx scripts/rename-module.ts",
    "move-sections": "tsx scripts/move-sections.ts",
    "contribution:issue": "tsx scripts/publish-local-changes.ts",
    "contribution:consolidate": "tsx scripts/consolidate.ts",
    "contribution:squash": "tsx scripts/squash-local-changes.ts",
    "modportal": "tsx scripts/modportal.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  }
}

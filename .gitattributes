# The index keeps LF for every text file, so a checkout on any platform parses
# the same bytes. The DSL is the reason this matters: a stray CR reattributes a
# section to the one above it, and content is authored by pasting through GitHub.
* text=auto eol=lf

# Two branches appending to a line-per-record file conflict on the last line
# for no reason a human can adjudicate. Union keeps both, which is exactly
# right for an append-only log; on the store its one failure mode is two
# branches editing the same record, which keeps both versions as a duplicate
# id and is what `tasks doctor` scans for.
docs/tasks.jsonl merge=union
docs/events.jsonl merge=union

# Windows tooling that needs its own line endings whatever the repo says.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jar binary
*.keystore binary

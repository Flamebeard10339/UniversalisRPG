# Emitted by tsc --build for the tsconfig.node project.
tsconfig.node.tsbuildinfo

# saveStore stages its write beside the store and takes a lock there. Both are
# removed on the way out; these two lines are for the write that was killed.
*.jsonl.lock
*.jsonl.*.tmp

# One file per save slot, written by whoever is playing.
.saves/

# The REPL's own working file. Whoever is playing stages edits into it, and the
# shipped corpus is not supposed to have a local-changes module in it.
content/local-changes.dsl
.authorbot/
